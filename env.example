# Copy to .env. Never commit credentials.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
# Existing defaults; choose models enabled in your provider account.
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
QWEN_MODEL=qwen3.8-max
# Recommended: workspace-specific Singapore endpoint (key must match region).
DASHSCOPE_WORKSPACE_ID=
# Optional full endpoint override for another region; never include an API key.
QWEN_BASE_URL=
PORT=8000
FRONTEND_URL=https://cae-animals.com
